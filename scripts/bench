#!/bin/sh
# Entry point of the erofs read benchmark.
#
#   bench build-image [options]   Linux host: fetch the dataset, build makefs
#                                 and create the disk image.
#   bench run [options] [board..] FreeBSD target: run the boards (default all).
#   bench list                    List the boards.
#
# Run "bench build-image -h" and "bench run -h" for the options.
set -e

here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib/common.sh"

BOARDS="1 2 3 4 5"

usage() {
	sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-2}"
}

board_file() {
	case $1 in
	1) echo "$here/tests/board1_large.sh" ;;
	2) echo "$here/tests/board2_small_seq.sh" ;;
	3) echo "$here/tests/board3_small_rand.sh" ;;
	4) echo "$here/tests/board4_golden.sh" ;;
	5) echo "$here/tests/board5_erofs.sh" ;;
	*) die "no such board: $1" ;;
	esac
}

cmd_list() {
	echo "1  large file sequential read        (erofs ufs zfs ext4, uncompressed)"
	echo "2  small files, sorted order         (erofs ufs zfs ext4, uncompressed)"
	echo "3  small files, random order         (erofs ufs zfs ext4, uncompressed)"
	echo "4  golden image full tree read       (erofs ufs zfs ext4, uncompressed)"
	echo "5  erofs compression algorithms      (erofs none lz4 lz4hc lzma deflate zstd)"
}

cmd_build_image() {
	exec "$here/host/build-all.sh" "$@"
}

# Benchmark targets: erofs (the uncompressed image), ufs, zfs, ext4. Sets NORM
# to the internal variant name.
norm_target() {
	case $1 in
	erofs|erofs-none) NORM=erofs-none ;;
	ufs|zfs|ext4) NORM=$1 ;;
	*) die "unknown benchmark target: $1 (use erofs, ufs, zfs or ext4)" ;;
	esac
}

cmd_run() {
	RUNS=5
	OUT=
	WORK=
	EROFS_MODE=module
	EROFS_SRC=
	EROFS_KO=
	verify=1
	PARTS=
	IMAGES_DIR=./benchmark-images
	reuse=0
	MEASURE=
	# getopts has no long options: handle --mount <target> before parsing.
	# The target may be repeated or comma separated.
	want=0
	for a in "$@"; do
		shift
		if [ "$want" -eq 1 ]; then
			want=0
			for t in $(echo "$a" | tr ',' ' '); do
				norm_target "$t"
				MEASURE="$MEASURE $NORM"
			done
			continue
		fi
		case $a in
		--mount) reuse=1; want=1 ;;
		--*) die "unknown option: $a" ;;
		*) set -- "$@" "$a" ;;
		esac
	done
	[ "$want" -eq 0 ] || die "--mount needs a target: erofs, ufs, zfs or ext4"
	while getopts n:o:w:e:s:k:p:i:Rxh o; do
		case $o in
		n) RUNS=$OPTARG ;;
		o) OUT=$OPTARG ;;
		w) WORK=$OPTARG ;;
		e) EROFS_MODE=$OPTARG ;;
		s) EROFS_SRC=$OPTARG ;;
		k) EROFS_KO=$OPTARG ;;
		p)
			case $OPTARG in
			*=*) norm_target "${OPTARG%%=*}"; PARTS="$PARTS $NORM=${OPTARG#*=}" ;;
			*) die "-p needs <target>=<device>, for example -p ufs=/dev/ada1p5" ;;
			esac
			;;
		i) IMAGES_DIR=$OPTARG ;;
		R) reuse=1 ;;
		x) verify=0 ;;
		h) cat <<USAGE
usage: bench run -p <target>=<device> [-p ...] [--mount <target>] [-i image dir]
                 [-n runs] [-e module|kernel] [-s erofs-freebsd tree]
                 [-k erofs.ko] [-o result dir] [-w work dir] [-R] [-x] [board..]
Targets: erofs (the uncompressed image), ufs, zfs, ext4.
  -p  the partition of one target, repeatable. erofs is always needed, because
      the file list that the other targets are checked against is read from it.
      A target without a partition is not measured. For example:
      -p erofs=/dev/ada1p4 -p ufs=/dev/ada1p5 -p zfs=/dev/ada1p6 -p ext4=/dev/ada1p7
  --mount <target>
      do not download and do not dd: mount the partition of <target> as it is
      (it must already hold its image) and benchmark only that target. May be
      repeated or comma separated: --mount ufs --mount zfs, --mount ufs,zfs.
      The erofs partition is mounted too, to read the file list.
  -R  like --mount, for every target that has a partition
  -i  directory of the release parts, default ./benchmark-images
  -n  rounds per target and workload, default 5
  -e  erofs mode: module builds and loads erofs.ko (default),
      kernel uses erofs of the running kernel
  -s  erofs-freebsd source tree (module mode)
  -k  prebuilt erofs.ko (module mode)
  -x  skip the content verification pass
Without --mount and -R, the parts benchmark-images.tar.gz.01, .02, ... of the
latest release of imrcpan/erofs-freebsd-benchmark are downloaded into the image
directory (skipped when they, or the unpacked images, are already there),
unpacked, and written with dd straight into the partitions. THE CONTENTS OF
THESE PARTITIONS ARE DESTROYED. Each must be at least as big as its image. The
partitions are created by you. Nothing is copied into a mounted file system.
USAGE
		   exit 0 ;;
		*) usage ;;
		esac
	done
	shift $((OPTIND - 1))
	[ "$(uname -s)" = FreeBSD ] || die "bench run must run on FreeBSD"
	[ "$(id -u)" -eq 0 ] || die "bench run needs root"
	[ -n "$PARTS" ] || die "bench run needs -p <target>=<device>; run bench run -h"
	boards=${*:-$BOARDS}
	[ "$boards" = all ] && boards=$BOARDS

	WORK=${WORK:-/var/tmp/erofs-bench}
	[ -n "$OUT" ] || OUT=$here/../results/$(date +%Y%m%d-%H%M%S)
	mkdir -p "$WORK" "$OUT"
	OUT=$(cd "$OUT" && pwd)
	export EROFS_MODE EROFS_SRC EROFS_KO WORK

	. "$here/lib/erofs_env.sh"
	. "$here/lib/fsops.sh"
	. "$here/lib/runner.sh"

	META=$WORK/meta
	rm -rf "$META"
	mkdir -p "$META"
	. "$here/lib/images.sh"
	for t in $MEASURE; do
		[ -n "$(part_dev "$t")" ] || die "--mount $t needs -p $t=<device>"
	done

	if [ "$reuse" -eq 0 ]; then
		images_fetch "$IMAGES_DIR"
		images_extract "$IMAGES_DIR"
		images_write "$IMAGES_DIR"
	else
		[ -n "$(part_dev erofs-none)" ] || die "-p erofs=<device> is needed to read the file list"
		for w in $PARTS; do
			[ -c "${w#*=}" ] || die "${w#*=} is not a disk device"
		done
	fi

	RDBENCH=$WORK/rdbench
	build_rdbench "$RDBENCH" "$here"

	erofs_setup
	images_manifest
	fs_describe >"$OUT/env.txt"
	echo "erofs_mode=$EROFS_MODE runs=$RUNS" >>"$OUT/env.txt"
	[ -n "$EROFS_KO" ] && sha256 -q "$EROFS_KO" >>"$OUT/env.txt"
	echo "board,workload,fs,state,run,files,bytes,secs,errors" >"$OUT/raw.csv"
	: >"$OUT/extra.md"

	if [ "$verify" -eq 1 ]; then
		verify_all || die "content verification failed, results would be meaningless"
	fi

	for b in $boards; do
		f=$(board_file "$b")
		log "== board $b =="
		(
			. "$f"
			board_main
		)
	done

	{
		echo "# erofs read benchmark"
		echo ""
		echo "rounds: $RUNS, erofs mode: $EROFS_MODE"
		awk -F, -f "$here/summary.awk" "$OUT/raw.csv"
		cat "$OUT/extra.md"
	} >"$OUT/summary.md"
	rm -f "$OUT/extra.md"
	log "results in $OUT (summary.md, raw.csv, env.txt)"
	cat "$OUT/summary.md"
}

[ $# -ge 1 ] || usage
sub=$1
shift
case $sub in
build-image) cmd_build_image "$@" ;;
run) cmd_run "$@" ;;
list) cmd_list ;;
-h|--help|help) usage 0 ;;
*) usage ;;
esac
