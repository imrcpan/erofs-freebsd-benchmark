#!/bin/sh
# Entry point of the erofs read benchmark.
#
#   bench run --mount <target> [board..]
#       FreeBSD target, one command: download the images (skipped when they are
#       already there), mount them, benchmark. Targets: erofs ufs zfs ext4.
#       The kernel with erofs must be installed and booted already.
#   bench list                    List the boards.
#   bench build-image [options]   Linux host: build the images locally.
#
# Run "bench run -h" for the options.
set -e

here=$(cd "$(dirname "$0")" && pwd)
. "$here/lib/common.sh"

BOARDS="1 2 3 4 5"

usage() {
	sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-2}"
}

board_file() {
	case $1 in
	1) echo "$here/tests/board1_large.sh" ;;
	2) echo "$here/tests/board2_small_seq.sh" ;;
	3) echo "$here/tests/board3_small_rand.sh" ;;
	4) echo "$here/tests/board4_golden.sh" ;;
	5) echo "$here/tests/board5_erofs.sh" ;;
	*) die "no such board: $1" ;;
	esac
}

cmd_list() {
	echo "1  large file sequential read        (erofs ufs zfs ext4, uncompressed)"
	echo "2  small files, sorted order         (erofs ufs zfs ext4, uncompressed)"
	echo "3  small files, random order         (erofs ufs zfs ext4, uncompressed)"
	echo "4  golden image full tree read       (erofs ufs zfs ext4, uncompressed)"
	echo "5  erofs compression algorithms      (erofs none lz4 lz4hc lzma deflate zstd)"
}

cmd_build_image() {
	exec "$here/host/build-all.sh" "$@"
}

# Benchmark targets: erofs (the uncompressed image), ufs, zfs, ext4. Sets NORM
# to the internal variant name.
norm_target() {
	case $1 in
	erofs|erofs-none) NORM=erofs-none ;;
	ufs|zfs|ext4) NORM=$1 ;;
	*) die "unknown benchmark target: $1 (use erofs, ufs, zfs or ext4)" ;;
	esac
}

cmd_run() {
	RUNS=5
	OUT=
	WORK=
	# The kernel with erofs is installed and booted beforehand
	# (dangerous-install-kernel.sh), so erofs comes from the running kernel.
	EROFS_MODE=kernel
	EROFS_SRC=
	EROFS_KO=
	verify=1
	PARTS=
	IMAGES_DIR=./benchmark-images
	reuse=0
	IMAGE_MODE=part
	MEASURE=
	# getopts has no long options: handle --mount <target> before parsing.
	# The target may be repeated or comma separated.
	want=0
	for a in "$@"; do
		shift
		if [ "$want" -eq 1 ]; then
			want=0
			for t in $(echo "$a" | tr ',' ' '); do
				norm_target "$t"
				MEASURE="$MEASURE $NORM"
			done
			continue
		fi
		case $a in
		--mount) IMAGE_MODE=file; want=1 ;;
		--*) die "unknown option: $a" ;;
		*) set -- "$@" "$a" ;;
		esac
	done
	[ "$want" -eq 0 ] || die "--mount needs a target: erofs, ufs, zfs or ext4"
	while getopts n:o:w:e:s:k:p:i:Rxh o; do
		case $o in
		n) RUNS=$OPTARG ;;
		o) OUT=$OPTARG ;;
		w) WORK=$OPTARG ;;
		e) EROFS_MODE=$OPTARG ;;
		s) EROFS_SRC=$OPTARG ;;
		k) EROFS_KO=$OPTARG ;;
		p)
			case $OPTARG in
			*=*) norm_target "${OPTARG%%=*}"; PARTS="$PARTS $NORM=${OPTARG#*=}" ;;
			*) die "-p needs <target>=<device>, for example -p ufs=/dev/ada1p5" ;;
			esac
			;;
		i) IMAGES_DIR=$OPTARG ;;
		R) reuse=1 ;;
		x) verify=0 ;;
		h) cat <<USAGE
usage: bench run --mount <target> [-n runs] [-i image dir] [-o result dir] [board..]
Targets: erofs (the uncompressed image), ufs, zfs, ext4. A comma list or a
repeated option selects several: --mount ufs,zfs  or  --mount ufs --mount zfs.

  --mount <target>
      Fully automatic, nothing is written to any disk or partition:
        1. the parts benchmark-images.tar.gz.01, .02, ... of the latest release
           of imrcpan/erofs-freebsd-benchmark are downloaded into the image
           directory, unless they, or the unpacked images, are already there;
        2. they are unpacked into the image directory;
        3. the image file of the target is attached read-only with mdconfig and
           mounted; the device and the mount point are printed;
        4. the benchmark runs on it.
      The erofs image is mounted too, to read the file list that the other
      targets are checked against.
  -i  directory of the release parts and images, default ./benchmark-images
  -n  rounds per target and workload, default 5
  -o  result directory, default results/<time>
  -x  skip the content verification pass
Other options: -e module|kernel (default kernel: erofs of the running kernel;
module builds erofs.ko with -s <erofs-freebsd tree> or loads -k <erofs.ko>),
-w <work dir>.

Writing the images into partitions with dd instead (the partitions are created
by you, THEIR CONTENTS ARE DESTROYED):
  bench run -p <target>=<device> [-p ...]      download, unpack, dd, measure
  bench run -R -p <target>=<device> [-p ...]   partitions already written:
                                               mount them and measure
USAGE
		   exit 0 ;;
		*) usage ;;
		esac
	done
	shift $((OPTIND - 1))
	[ "$(uname -s)" = FreeBSD ] || die "bench run must run on FreeBSD"
	[ "$(id -u)" -eq 0 ] || die "bench run needs root"
	if [ "$IMAGE_MODE" = file ]; then
		[ -z "$PARTS" ] && [ "$reuse" -eq 0 ] ||
		    die "--mount cannot be combined with -p or -R"
	else
		[ -n "$PARTS" ] || die "bench run needs --mount <target> (or -p <target>=<device>); run bench run -h"
	fi
	boards=${*:-$BOARDS}
	[ "$boards" = all ] && boards=$BOARDS

	WORK=${WORK:-/var/tmp/erofs-bench}
	[ -n "$OUT" ] || OUT=$here/../results/$(date +%Y%m%d-%H%M%S)
	mkdir -p "$WORK" "$OUT"
	OUT=$(cd "$OUT" && pwd)
	export EROFS_MODE EROFS_SRC EROFS_KO WORK

	. "$here/lib/erofs_env.sh"
	. "$here/lib/fsops.sh"
	. "$here/lib/runner.sh"

	META=$WORK/meta
	rm -rf "$META"
	mkdir -p "$META"
	. "$here/lib/images.sh"
	if [ "$IMAGE_MODE" = part ]; then
		for t in $MEASURE; do
			[ -n "$(part_dev "$t")" ] || die "$t needs -p $t=<device>"
		done
	fi

	export IMAGE_MODE IMAGES_DIR
	if [ "$IMAGE_MODE" = file ]; then
		images_fetch "$IMAGES_DIR"
		images_extract "$IMAGES_DIR"
		IMAGES_DIR=$(cd "$IMAGES_DIR" && pwd)
		for t in $MEASURE erofs-none; do
			[ -s "$(image_file "$t")" ] || die "no image for $t in $IMAGES_DIR"
		done
	elif [ "$reuse" -eq 0 ]; then
		images_fetch "$IMAGES_DIR"
		images_extract "$IMAGES_DIR"
		images_write "$IMAGES_DIR"
	else
		[ -n "$(part_dev erofs-none)" ] || die "-p erofs=<device> is needed to read the file list"
		for w in $PARTS; do
			[ -c "${w#*=}" ] || die "${w#*=} is not a disk device"
		done
	fi
	trap fs_cleanup EXIT INT TERM HUP

	RDBENCH=$WORK/rdbench
	build_rdbench "$RDBENCH" "$here"

	erofs_setup
	images_manifest
	fs_describe >"$OUT/env.txt"
	echo "erofs_mode=$EROFS_MODE runs=$RUNS" >>"$OUT/env.txt"
	[ -n "$EROFS_KO" ] && sha256 -q "$EROFS_KO" >>"$OUT/env.txt"
	echo "board,workload,fs,state,run,files,bytes,secs,errors" >"$OUT/raw.csv"
	: >"$OUT/extra.md"

	if [ "$verify" -eq 1 ]; then
		verify_all || die "content verification failed, results would be meaningless"
	fi

	for b in $boards; do
		f=$(board_file "$b")
		log "== board $b =="
		(
			. "$f"
			board_main
		)
	done

	{
		echo "# erofs read benchmark"
		echo ""
		echo "rounds: $RUNS, erofs mode: $EROFS_MODE"
		awk -F, -f "$here/summary.awk" "$OUT/raw.csv"
		cat "$OUT/extra.md"
	} >"$OUT/summary.md"
	rm -f "$OUT/extra.md"
	log "results in $OUT (summary.md, raw.csv, env.txt)"
	cat "$OUT/summary.md"
}

[ $# -ge 1 ] || usage
sub=$1
shift
case $sub in
build-image) cmd_build_image "$@" ;;
run) cmd_run "$@" ;;
list) cmd_list ;;
-h|--help|help) usage 0 ;;
*) usage ;;
esac
